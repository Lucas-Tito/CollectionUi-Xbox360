+        // tudo: so acontece em tela com nome truncado (os dois grids usam TRUNCATED), e
+        // e intermitente porque depende de ONDE a reserva caiu.
+        //
+        // Descontando antes, todo quad escrito consome um slot reservado.
+        dwNumChars--;
